# LandTrace Environment Variables Example
# Copy this file to .env.local for local development. Never commit real credentials.

# Neon Serverless PostgreSQL Connection String (Pooled)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct Connection String for Prisma Migrations (Unpooled)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"
